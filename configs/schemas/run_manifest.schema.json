{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent training-run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform",
    "condition_id",
    "cell_id",
    "method",
    "run_id",
    "training_seed",
    "model_init_seed",
    "optimizer_seed",
    "data_order_seed",
    "checkpoint_id",
    "checkpoint_path",
    "config_path",
    "config_sha256",
    "training_status"
  ],
  "properties": {
    "platform": {"type": "string", "minLength": 1},
    "condition_id": {"type": "string", "minLength": 1},
    "cell_id": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "training_seed": {"type": "integer", "minimum": 0},
    "model_init_seed": {"type": "integer", "minimum": 0},
    "optimizer_seed": {"type": "integer", "minimum": 0},
    "data_order_seed": {"type": "integer", "minimum": 0},
    "checkpoint_id": {"type": "string"},
    "checkpoint_path": {"type": "string"},
    "config_path": {"type": "string"},
    "config_sha256": {"type": "string"},
    "code_commit": {"type": "string"},
    "training_status": {"type": "string", "enum": ["planned", "running", "complete", "failed"]},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"training_status": {"const": "complete"}},
        "required": ["training_status"]
      },
      "then": {
        "properties": {
          "checkpoint_id": {"type": "string", "minLength": 1},
          "config_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "code_commit": {"type": "string", "minLength": 1}
        },
        "required": ["checkpoint_id", "config_sha256", "code_commit"]
      }
    }
  ]
}
